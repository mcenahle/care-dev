---
import "../styles/global.scss";
import { Icon } from "astro-icon/components";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const { title } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/css/nhsuk-frontend.min.css" />
    <title>{title ? `${title} | mcenahle.care` : "mcenahle.care"}</title>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>

  <script>
    document.body.className +=
      " js-enabled" +
      ("noModule" in HTMLScriptElement.prototype
        ? " nhsuk-frontend-supported"
        : "");
  </script>

  <script is:inline type="module" src="/js/nhsuk-frontend.min.js"></script>
  <script is:inline type="module">
    import { initAll } from "/js/nhsuk-frontend.min.js";
    initAll();
  </script>
</html>
