---
import { Icon } from "astro-icon/components";
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";
---

<div class="nhsuk-panel nhsuk-panel--interruption">
  <img
    src="https://resources.mcenahle.page/sites/mcenahle.care/@/pictures/event_introduction.jpg"
    alt="Event introduction"
    class="repositive-img"
    style="margin-bottom: 16px;"
  />
  <h1 class="nhsuk-panel__heading nhsuk-panel__heading--l">
    世界技能大赛 - 健康和社会照护项目观赛
  </h1>
  <div class="nhsuk-panel__body">
    <p>
      <Icon name="mdi:clock-time-four-outline" /> 计划的参观时间：08:00 AM to 10:00
      AM
    </p>
    <p><Icon name="mdi:place" /> 地点：国家会展中心（上海）</p>
    <div class="nhsuk-button-group">
      <a
        href="https://worldskills2026.com.cn/release/3970/"
        target="_blank"
        class="nhsuk-button"
        data-module="nhsuk-button"
      >
        了解该比赛 <ExternalLinkIcon />
      </a>
      <a
        href="/nursing/activity/"
        class="nhsuk-button nhsuk-button--reverse"
        data-module="nhsuk-button"
        role="button"
        draggable="false"
      >
        护理周——预热活动
      </a>
    </div>
  </div>
</div>
