---
import { Icon } from "astro-icon/components";
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";
---

<div
  class="nhsuk-notification-banner"
  data-module="nhsuk-notification-banner"
  role="region"
  aria-labelledby="nhsuk-notification-banner-title"
>
  <div class="nhsuk-notification-banner__header">
    <h2
      class="nhsuk-notification-banner__title"
      id="nhsuk-notification-banner-title"
    >
      来自一位伟人的话
    </h2>
  </div>
  <div class="nhsuk-notification-banner__content">
    <p class="nhsuk-notification-banner__heading">
      The word from Florence Nightingale:
      <blockquote class="nhsuk-inset-text">
        <p>“Nursing is an art.”</p>
        <footer style="text-align: right;">— Florence Nightingale</footer>
      </blockquote>
    </p>
    <a
      class="nhsuk-button nhsuk-button--login"
      data-module="nhsuk-button"
      href="https://zh.wikipedia.org/wiki/%E5%BC%97%E7%BE%85%E5%80%AB%E6%96%AF%C2%B7%E5%8D%97%E4%B8%81%E6%A0%BC%E7%88%BE"
      target="_blank"
      role="button"
      draggable="false"
    >
      wikipedia 关于南丁格尔的介绍 <ExternalLinkIcon />
    </a>
  </div>
</div>
