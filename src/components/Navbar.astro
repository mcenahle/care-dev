            class="nhsuk-header__navigation-link"
            href="https://donate-blood.mcenahle.care"
            target="_blank"
            ><Icon name="mdi:hand-heart" /> 献血 <ExternalLinkIcon /></a
          >
        </li>
        <li class="nhsuk-header__navigation-item">
          <a
            class="nhsuk-header__navigation-link"
            href="https://mail.mcenahle.care">webmail <ExternalLinkIcon /></a
          >
        </li>
