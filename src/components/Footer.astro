---
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";
---

<footer class="nhsuk-footer" role="contentinfo">
  <div class="nhsuk-width-container">
    <div class="nhsuk-footer__navigation nhsuk-grid-row">
      <div class="nhsuk-grid-column-one-quarter">
        <ul class="nhsuk-footer__list">
          <li class="nhsuk-footer__list-item">
            <a class="nhsuk-footer__list-item-link" href="/nursing/"
              ><u>护理学</u></a
            >
          </li>
          <li class="nhsuk-footer__list-item">
            <a class="nhsuk-footer__list-item-link" href="/posts/"
              ><u>医学相关文章</u></a
            >
          </li>
          <li class="nhsuk-footer__list-item">
            <a class="nhsuk-footer__list-item-link" href="/papers/"
              ><u>医学论文</u></a
            >
          </li>
        </ul>
      </div>
      <div class="nhsuk-grid-column-one-quarter">
        <ul class="nhsuk-footer__list">
          <li class="nhsuk-footer__list-item">
            <a
              class="nhsuk-footer__list-item-link"
              href="https://mcenahle.page"
              target="_blank"><u>mcenahle.page</u> <ExternalLinkIcon /></a
            >
          </li>
          <li class="nhsuk-footer__list-item">
            <a
              class="nhsuk-footer__list-item-link"
              href="https://mcenahle.dev"
              target="_blank"><u>mcenahle.dev</u> <ExternalLinkIcon /></a
            >
          </li>
        </ul>
      </div>
      <div class="nhsuk-grid-column-one-half">
        <p class="nhsuk-body-s nhsuk-u-margin-bottom-6">
          <strong>mcenahle.care</strong> 是个人的医学、护理专题的网站，虽然 <a
            href="https://www.spaceship.com/zh/domains/gtld/care/"
            target="_blank"
            ><u>.care 一年注册、续费的费用不菲</u> <ExternalLinkIcon /></a
          >，但是医学也是本人最大的爱好之一。
        </p>
      </div>
    </div>
    <div class="nhsuk-footer__navigation nhsuk-grid-row">
      <div class="nhsuk-grid-column-full">
        <p class="nhsuk-body-s">网站主要开发地点：上海市浦东新区、崇明区。</p>
      </div>
    </div>
    <div class="nhsuk-footer__meta">
      <p class="nhsuk-body-s">
        © 2026 mcenahle.care. Made by <a
          href="https://nhsuk.github.io/nhsuk-frontend/"
          target="_blank"><u>NHS.UK frontend</u> <ExternalLinkIcon /></a
        >.
      </p>
    </div>
  </div>
</footer>
