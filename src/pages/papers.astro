---
import Layout from "../layouts/Layout.astro";
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";

const title = "医学论文";
---

<Layout title={title}>
  <div class="container">
    <h2>{title}</h2>
    <h3>中华医学期刊全文数据库（上海图书馆）</h3>

    <nav
      class="nhsuk-contents-list"
      role="navigation"
      aria-label="Pages in this guide"
    >
      <h2 class="nhsuk-u-visually-hidden">Contents</h2>
      <ol class="nhsuk-contents-list__list">
        <li class="nhsuk-contents-list__item">
          <a
            class="nhsuk-contents-list__link"
            href="https://z.library.sh.cn/go?url=http://www.yiigle.com/index"
            target="_blank"
            ><u>馆外访问（成为上海图书馆读者以访问）</u> <ExternalLinkIcon /></a
          >
        </li>
        <li class="nhsuk-contents-list__item">
          <a
            class="nhsuk-contents-list__link"
            href="https://z.library.sh.cn/go-anonymous?url=http://www.yiigle.com/index"
            target="_blank"
            ><u
              >馆内访问（成为上海图书馆读者，并在图书馆内连接无线局域网以访问）</u
            >&nbsp;
            <ExternalLinkIcon /></a
          >
        </li>
      </ol>
    </nav>
  </div>
</Layout>
