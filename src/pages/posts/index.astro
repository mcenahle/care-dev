---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const POSTS_PER_PAGE = 10;

const allPosts = Object.values(
  import.meta.glob("./*.md", { eager: true }),
).sort(
  (a: any, b: any) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);

const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

const title = "医学相关文章";
---

<Layout title={title}>
  <div class="container">
    <h2>{title}</h2>

    <p>mcenahle.care 医学相关文章</p>

    <article class="ucla-card ucla-card__story">
      {
        posts.map((post: any) => (
          <div class="nhsuk-card">
            <div class="nhsuk-card__content">
              <h3 class="nhsuk-card__heading nhsuk-heading-m">
                <a
                  class="nhsuk-card__link"
                  href={post.url}
                  title={post.frontmatter.title}
                >
                  {post.frontmatter.title}
                </a>
              </h3>
              <p class="nhsuk-card__description">
                By {post.frontmatter.author}
              </p>
              <p class="nhsuk-card__description">
                {post.frontmatter.description}
              </p>
              <p class="nhsuk-card__description">{post.frontmatter.pubDate}</p>
            </div>
          </div>
        ))
      }
    </article>
  </div>
</Layout>
